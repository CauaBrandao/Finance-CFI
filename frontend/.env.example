# Em desenvolvimento local (npm run dev), deixe comentado para usar o proxy Vite (/api -> http://localhost:8080)
# Em produção (Vercel/Netlify/Render), defina a URL pública HTTPS completa da API com /api no final:
# VITE_API_URL=https://sua-api.onrender.com/api
VITE_API_URL=http://localhost:8080/api
