# Chave de API do Google Gemini (obrigatória para IA generativa; sem ela o sistema usa fallback determinístico)
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=

# Modelo Gemini a ser utilizado (padrão: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Porta do Servidor Spring Boot (em produção, plataformas como Render usam PORT)
SERVER_PORT=8080

# Perfil ativo: deixe vazio/default em dev; use 'prod' em produção
SPRING_PROFILES_ACTIVE=

# Origens permitidas no CORS (separadas por vírgula; em produção informe o domínio real HTTPS do frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Política de Swagger em produção (true/false; no perfil prod é false por padrão)
SPRINGDOC_SWAGGER_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true
